{
  "name": "paralax-companion",
  "productName": "Paralax Verse Companion",
  "version": "0.6.3",
  "description": "An in-game companion overlay for Star Citizen, from Paralax Verse. Unofficial fan project.",
  "main": "main.js",
  "author": {
    "name": "Paralax Verse",
    "email": "noreply@paralaxverse.com"
  },
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.paralaxverse.companion",
    "productName": "Paralax Verse Companion",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Paralax Verse Companion",
      "artifactName": "Paralax-Verse-Companion-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "node_modules/koffi/**"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "Paralax-Verse-Companion-${version}.${ext}",
      "synopsis": "Unofficial Star Citizen companion overlay"
    }
  },
  "dependencies": {
    "uiohook-napi": "1.5.4",
    "koffi": "^2.9.0"
  }
}
